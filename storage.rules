rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Validates files are images under 5MB
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Profile Images bucket rules
    match /profile_images/{userId}/{imageId} {
      // Anyone logged in can view profile pictures
      allow read: if isAuthenticated();
      // Only the user themselves can upload/update/delete their picture
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
    }

    // Report Images bucket rules
    match /report_images/{userId}/{imageId} {
      // Any authenticated user can view report images
      allow read: if isAuthenticated();
      // Only the reporter can upload their evidence
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
    }
    
    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
