# Firebase source (project ewer-8f788). Either a path to a service-account key
# JSON file or the JSON itself. Falls back to GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=./ewer-8f788-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=ewer-8f788
FIREBASE_STORAGE_BUCKET=ewer-8f788.firebasestorage.app

# Supabase target (service role key: bypasses RLS — keep secret).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --send-password-resets only
# Where the reset link lands (must be in Supabase Auth → URL configuration → Redirect URLs).
PASSWORD_RESET_REDIRECT_URL=
# Delay between reset emails in ms.
RESET_THROTTLE_MS=2000
