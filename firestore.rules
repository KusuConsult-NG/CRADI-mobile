rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  CRADI / EWER Firebase Firestore Security Rules
//  Project: ewer-8f788
//  Last updated: 2026-03-02
// ─────────────────────────────────────────────────────────────────────────────
//
//  Role hierarchy (stored on each user document at users/{uid}.role):
//    user         → community member, can submit reports
//    ewm          → Early Warning Monitor, can verify reports in their ward
//    ewv          → Early Warning Validator, can verify + reject reports
//    ewr          → Early Warning Responder, can mark resolved
//    ldp_coordinator → LGA-level coordinator, escalation recipient
//    project_staff   → Project-wide staff
//    techSupport  → tech support, read-only most collections
//    admin        → full read/write across all collections
//
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDoc().role;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in [
        'ewm', 'ewv', 'ewr', 'ldp_coordinator', 'project_staff', 'admin', 'techSupport'
      ];
    }

    function isVerifier() {
      return isAuthenticated() && getUserRole() in ['ewm', 'ewv', 'ewr', 'admin'];
    }

    // Ward-scoped: caller must belong to the same ward as the resource
    function sameWard(ward) {
      return isAuthenticated() && userDoc().ward == ward;
    }

    // LGA-scoped: caller must belong to the same LGA as the resource
    function sameLga(lga) {
      return isAuthenticated() && userDoc().lga == lga;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read their own profile. Staff can read all profiles (for peer lookup).
      allow read: if isOwner(uid) || isStaff();

      // Anyone authenticated can create their own user document on signup.
      allow create: if isAuthenticated() && request.auth.uid == uid
        // Must not self-assign elevated roles at creation time.
        && request.resource.data.role in ['user', 'ewm'];

      // Users can update their own non-sensitive fields.
      // Admins can update anything, including role.
      allow update: if isAdmin()
        || (isOwner(uid) && (
          // Only allow specific field updates for non-admins
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isApproved'])
        ));

      allow delete: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Authenticated users can submit their own reports (status must start as 'pending').
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        // Prevent userId spoofing
        && request.resource.data.keys().hasAll(['userId', 'status', 'hazardType', 'lga']);

      // Authors can always read their own reports.
      // EWMs can read pending/escalated reports in their own ward only.
      // Senior staff (ewv, ewr, coordinator, admin) can read all reports.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || (hasRole('ewm') && sameWard(resource.data.ward))
        || getUserRole() in ['ewv', 'ewr', 'ldp_coordinator', 'project_staff', 'admin', 'techSupport']
      );

      // Staff can update status fields. Authors can only update their own 'pending' reports.
      allow update: if isStaff()
        || (isOwner(resource.data.userId) && resource.data.status == 'pending');

      // Only admins can delete reports (soft-delete preferred).
      allow delete: if isAdmin();
    }

    // ── verifications ─────────────────────────────────────────────────────────
    match /verifications/{verificationId} {
      // Verifiers can read verifications; tech support can too.
      allow read: if isVerifier() || hasRole('techSupport');

      // EWM/EWV/EWR can create verifications, but NOT for their own reports.
      allow create: if isVerifier()
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.userId != request.auth.uid
        // Enforce required fields
        && request.resource.data.keys().hasAll(['reportId', 'verifierId', 'isConfirmed']);

      allow update, delete: if isAdmin();
    }

    // ── otp_verifications ─────────────────────────────────────────────────────
    match /otp_verifications/{docId} {
      // Allow an authenticated user to read their OWN OTP document.
      // Ownership: stored email or phone must match the Firebase Auth token claim.
      allow get: if isAuthenticated() && (
        resource.data.email == request.auth.token.email
        || resource.data.phone == request.auth.token.phone_number
      );

      // Listing all OTPs is always denied.
      allow list: if false;

      // Anyone (including unauthenticated sign-up) can create with required fields.
      allow create: if true
        && request.resource.data.keys().hasAll(['code', 'createdAt', 'expiresAt', 'used', 'attempts']);

      allow update: if (
        // 1. Resend: full replacement, rate-limited to once per 60 s
        request.resource.data.used == false
        && request.resource.data.keys().hasAll(['code', 'createdAt', 'expiresAt', 'used', 'attempts'])
        && (request.time > resource.data.createdAt + duration.value(60, 's'))
      ) || (
        // 2. Mark-as-used after app-side verification.
        //    Only `used` may change; expiry must still be valid.
        isAuthenticated()
        && (
          resource.data.email == request.auth.token.email
          || resource.data.phone == request.auth.token.phone_number
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true
        && request.time < resource.data.expiresAt
      ) || (
        // 3. Increment attempts counter (pre-auth — allowed for brute-force tracking).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts'])
        && request.resource.data.attempts == resource.data.attempts + 1
      );

      allow delete: if isAdmin();
    }

    // ── alerts ────────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      // All authenticated users can read alerts (community broadcasts).
      allow read: if isAuthenticated();
      // Only senior staff can write alerts (Cloud Functions use Admin SDK and bypass rules).
      allow write: if getUserRole() in ['ewv', 'ewr', 'ldp_coordinator', 'project_staff', 'admin'];
    }

    // ── messages (chat) ───────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ── contacts ──────────────────────────────────────────────────────────────
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── knowledge_base ────────────────────────────────────────────────────────
    match /knowledge_base/{guideId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── trusted_devices ───────────────────────────────────────────────────────
    match /trusted_devices/{deviceId} {
      // Users can only access their own device records.
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      // No update — devices are immutable; re-register to replace.
      allow update: if false;
    }

    // ── login_history ─────────────────────────────────────────────────────────
    match /login_history/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      // Immutable once written.
      allow update, delete: if isAdmin();
    }

    // ── scheduled_escalations ─────────────────────────────────────────────────
    // Written by PeerVerificationService; processed by Cloud Functions (Admin SDK).
    // The Admin SDK bypasses all rules, so the only concern is app-layer writes.
    match /scheduled_escalations/{docId} {
      // Only senior staff / admin can read (or Cloud Functions via Admin SDK).
      allow read: if getUserRole() in ['ldp_coordinator', 'project_staff', 'admin'];

      // Any verified EWM/EWV/EWR can create an escalation entry for their own report actions.
      allow create: if isVerifier()
        && request.resource.data.keys().hasAll(['reportId', 'escalateAt', 'status'])
        && request.resource.data.status == 'pending';

      // Only admin and Cloud Functions (Admin SDK) can update/delete.
      allow update, delete: if isAdmin();
    }

    // ── ndpa_consents ─────────────────────────────────────────────────────────
    // Stores user consent records for NDPA audit trail.
    match /ndpa_consents/{uid} {
      // Users can read and write only their own consent record.
      allow read, create: if isOwner(uid);
      // Consent records are immutable after creation (no update/delete).
      allow update, delete: if isAdmin();
    }

    // ── Deny everything else by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
