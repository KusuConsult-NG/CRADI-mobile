rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  CRADI / EWER Firebase Firestore Security Rules
//  Project: ewer-8f788
//  Last updated: 2026-02-26
// ─────────────────────────────────────────────────────────────────────────────
//
//  Role hierarchy (stored on each user document at users/{uid}.role):
//    user         → community member, can submit reports
//    ewm          → Early Warning Monitor, can verify reports
//    ewv          → Early Warning Validator, can verify + reject reports
//    ewr          → Early Warning Responder, can mark resolved
//    techSupport  → tech support, read-only most collections
//    admin        → full read/write across all collections
//
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['ewm', 'ewv', 'ewr', 'admin', 'techSupport'];
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read and update their own profile.
      // Admins and tech support can read all profiles.
      allow read: if isOwner(uid) || isStaff();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Anyone authenticated can submit a report.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Authors and staff can read reports.
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isStaff());

      // Status updates (verify/reject/resolve) restricted to staff.
      // Authors can update their own reports only if status remains 'pending'.
      allow update: if isStaff()
        || (isOwner(resource.data.userId) && resource.data.status == 'pending');

      // Only admins can delete reports (soft-delete preferred).
      allow delete: if isAdmin();
    }

    // ── verifications ─────────────────────────────────────────────────────────
    match /verifications/{verificationId} {
      allow read: if isStaff();
      // EWM/EWV/EWR and above can create verifications.
      // A user cannot verify their own report.
      allow create: if isAuthenticated()
        && getUserRole() in ['ewm', 'ewv', 'ewr', 'admin']
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.userId != request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── alerts ────────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      // All authenticated users can read alerts (community broadcasts).
      allow read: if isAuthenticated();
      // Only staff can create, update, or delete alerts.
      allow write: if isStaff();
    }

    // ── messages (chat) ───────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;
      // Authors can update/delete their own messages. Admins can delete any.
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ── contacts ──────────────────────────────────────────────────────────────
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Only the contact creator or admin can update/delete.
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── knowledge_base ────────────────────────────────────────────────────────
    match /knowledge_base/{guideId} {
      // Any authenticated user can read guides.
      allow read: if isAuthenticated();
      // Only admins and staff can manage guides.
      allow write: if isAdmin();
    }

    // ── trusted_devices ───────────────────────────────────────────────────────
    match /trusted_devices/{deviceId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // ── login_history ─────────────────────────────────────────────────────────
    match /login_history/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      // Immutable once written (no update/delete).
      allow update, delete: if isAdmin();
    }

    // ── scheduled_escalations (written by PeerVerificationService) ────────────
    match /scheduled_escalations/{docId} {
      // Only cloud functions (admin SDK) and app admins read escalations.
      allow read: if isAdmin();
      // App can create escalation entries for Cloud Function triggers.
      allow create: if isAuthenticated();
      // Only admins / Cloud Functions (using Admin SDK, which bypasses rules) update.
      allow update, delete: if isAdmin();
    }

    // ── Deny everything else by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
