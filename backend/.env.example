# Copy to .env for local development (never commit .env).

# Required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Push notifications (OneSignal). If unset, pushes are logged and skipped.
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
# Optional Android notification channel (OneSignal dashboard > Settings > Android Categories)
ONESIGNAL_ANDROID_CHANNEL_ID=

# Transactional email (Resend). If unset, POST /email returns 503.
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=noreply@cradi.ng
FROM_NAME=EWER Alert System

# SMS to local authorities when a report is approved.
# SMS_PROVIDER = termii | twilio. Unset (or credentials incomplete) -> SMS are logged and skipped.
SMS_PROVIDER=
# Termii (Nigeria): API key + registered sender ID (also used as the "from" for Termii).
TERMII_API_KEY=
SMS_SENDER_ID=
# Twilio: Account SID + Auth Token (basic auth) and a sending number in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Runtime
PORT=8080
WORKER_POLL_MS=5000
ESCALATION_POLL_MS=60000
# Comma-separated browser origins allowed to call POST /email ("*" for any). Empty = no CORS headers.
CORS_ORIGINS=
