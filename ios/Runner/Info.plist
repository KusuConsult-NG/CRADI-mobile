<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>EWER</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>EWER</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Custom URL scheme: cradi://report/xyz, cradi://alert/xyz
         For Universal Links (https://cradi.ng/...) add Associated Domains entitlement
         in Xcode: applinks:cradi.ng — and host apple-app-site-association at that domain -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>ng.cradi.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cradi</string>
			</array>
		</dict>
	</array>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Schemes url_launcher's canLaunchUrl may query (emergency calls,
	     SMS, email support, web links). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
		<string>https</string>
		<string>http</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Only `remote-notification` (OneSignal). No background fetch is
	     implemented, and declaring one App Review cannot see invites a
	     rejection. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app needs access to location when open to pinpoint incident reports.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app needs to recognize your speech to transcribe hazard descriptions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs microphone access to listen to your voice input for hazard reports.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app requires access to the photo library to upload hazard evidence.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock the app and protect your account.</string>
	<key>NSCameraUsageDescription</key>
	<string>This app requires access to the camera to take hazard evidence photos.</string>
	<!-- Languages the app ships (see lib/l10n/app_*.arb). iOS picks the
	     matching Runner/<lang>.lproj/InfoPlist.strings for the permission
	     prompts above; the values here are the English fallback. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ha</string>
		<string>yo</string>
		<string>ig</string>
		<string>pcm</string>
	</array>
	<!-- EXPORT COMPLIANCE — deliberately NOT declared here.
	     ITSAppUsesNonExemptEncryption = false would claim the app only uses
	     HTTPS/TLS and the platform's own crypto. That is not accurate: the
	     app bundles its own AES implementations to encrypt data at rest —
	     Hive boxes are opened with an AES-256 cipher (hive_encryption_service
	     .dart) and EncryptionService uses PointyCastle AES-256-GCM with
	     PBKDF2-SHA256 (encryption_service.dart). The algorithms are standard,
	     but they are not OS-provided and not limited to authentication, so
	     the usual "exempt" answers do not obviously apply.
	     Decide with whoever owns export compliance, then add the key (and,
	     if it is true, an annual self-classification report). See
	     docs/DEPLOYMENT.md "Export compliance". -->
</dict>
</plist>
