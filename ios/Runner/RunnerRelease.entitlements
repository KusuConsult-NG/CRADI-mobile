<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RELEASE entitlements (TestFlight / App Store). APNs tokens issued
	     against the sandbox are rejected by the production gateway, so an
	     archived build must carry "production" or push silently fails.
	     The Debug/Profile counterpart is Runner.entitlements; keep both in
	     sync when adding a capability. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
