<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the brand-red background of the app icon with the EWER
     mark centred, matching the in-app splash screen. Shown until the Flutter
     engine draws its first frame. Deliberately identical in light and dark
     mode (values-night/styles.xml points LaunchTheme here too). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_red" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
