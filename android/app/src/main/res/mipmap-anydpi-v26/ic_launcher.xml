<?xml version="1.0" encoding="utf-8"?>
<!--
  No <inset> here. The foreground's padding is baked into
  assets/images/app_icon_foreground.png, whose artwork is sized so its whole
  bounding box fits the 66dp safe circle of the 108dp layer. An inset on top
  of that padded asset shrinks the mark twice, which is what left it floating
  in the middle of a large white circle on the device.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
