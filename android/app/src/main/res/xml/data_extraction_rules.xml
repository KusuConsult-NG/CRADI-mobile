<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules — CRADI / EWER Mobile.

  android:allowBackup="false" already blocks cloud backup on every API level,
  but on API 31+ it does NOT block device-to-device transfer: without these
  rules a new phone would receive the Hive boxes, SharedPreferences and the
  keystore-wrapped flutter_secure_storage entries. Exclude everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
