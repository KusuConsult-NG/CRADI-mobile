<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Configuration — CRADI / EWER Mobile

  No cleartext traffic; system CAs only (user CAs in debug builds). Backend
  traffic goes to Supabase (*.supabase.co), the Railway backend, OneSignal
  and Sentry over HTTPS.
-->
<network-security-config>

    <!-- ── Base config: no cleartext, system CAs only ─────────────────────── -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>



    <!-- ── Africa's Talking / Termii SMS API ─────────────────────────────── -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.africastalking.com</domain>
        <domain includeSubdomains="true">api.ng.termii.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- ── Debug overrides: trust user-installed CAs only in debug builds ── -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
