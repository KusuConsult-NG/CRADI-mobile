<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Configuration — CRADI / EWER Mobile
  Updated: 2026-03-02

  SSL Certificate Pinning for Firebase/Google APIs.

  ⚠️  PIN ROTATION POLICY: These pins must be rotated before the leaf certificates expire.
       Monitor https://pki.goog/roots.pem for root CA changes.
       Current pins are the SHA-256 SPKI fingerprints of Google Trust Services roots
       (GTS Root R1 + R2 + R3 + R4) that Google rotates on a roughly 4-year cycle.
       Leaf certs expire on ~2027-09-30 for *.googleapis.com.

  ⚠️  BACKUP PIN: Always keep at least one backup pin (the current + next root) to avoid
       locking out users during a rotation.
-->
<network-security-config>

    <!-- ── Base config: no cleartext, system CAs only ─────────────────────── -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>



    <!-- ── Africa's Talking / Termii SMS API ─────────────────────────────── -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.africastalking.com</domain>
        <domain includeSubdomains="true">api.ng.termii.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- ── Debug overrides: trust user-installed CAs only in debug builds ── -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
